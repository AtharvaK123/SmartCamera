# Copy this file to server/.env and fill it in. Never commit .env.
PORT=8787

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ELEVENLABS_API_KEY=
# Default voice, used until someone picks their own during setup
ELEVENLABS_VOICE_ID=

# Tiger Data connection string, with the password: postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# Public wallet address only. The secret key stays in your wallet, never here.
SOLANA_MERCHANT=
SOLANA_NETWORK=devnet

# Presage SmartSpectra (camera vitals), used by the Android app
PRESAGE_API_KEY=

# Admin account (full access + manage accounts). Rebuild the app after changing it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Any long random string; signs website logins
SESSION_SECRET=
